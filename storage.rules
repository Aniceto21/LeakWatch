rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Civic issue grievance photographs
    match /complaints/{complaintId}/images/{imageFile} {
      // Allow reading images for tracking lookup and admin verification
      allow read: if true;

      // Allow uploading valid images (JPG, JPEG, PNG, WEBP) under 10 MB
      allow create, update: if request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');

      // Allow delete for cleanup of partial/aborted uploads or admin removal
      allow delete: if true;
    }

    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
